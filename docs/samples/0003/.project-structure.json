{
    "version": "1.0.0",
    "ignore": ["node_modules", "dist", ".git"],
    "root": {
        "src": {
            "kind": "folder",
            "required": true,
            "description": "Source code",
            "children": {
                "index.ts": {
                    "kind": "file",
                    "required": true
                },
                "repositories": {
                    "kind": "folder",
                    "children": {
                        "{{name}}Repository": {
                            "kind": "folder",
                            "strict": true,
                            "variables": {
                                "name": { "convention": "camelCase" }
                            },
                            "children": {
                                "I{{name}}Repository.ts": {
                                    "kind": "file",
                                    "required": true,
                                    "variables": {
                                        "name": { "convention": "PascalCase" }
                                    }
                                },
                                "{{implementation}}{{name}}Repository.ts": {
                                    "kind": "file",
                                    "required": true,
                                    "variables": {
                                        "name": { "convention": "PascalCase" },
                                        "implementation": { "convention": "PascalCase" }
                                    },
                                    "companions": [
                                        "{{implementation}}{{name}}Repository.unit.spec.ts"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
