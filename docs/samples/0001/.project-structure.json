{
    "version": "1.0.0",
    "ignore": [
        "node_modules"
    ],
    "root": {
        "src": {
            "kind": "folder",
            "description": "Source folder",
            "children": {
                "index.ts": {
                    "kind": "file",
                    "required": true
                },
                "repositories": {
                    "kind": "folder",
                    "description": "Repositories folder",
                    "children": {
                        "{{name}}Repository": {
                            "kind": "folder",
                            "description": "Repository folder",
                            "variables": {
                                "name": {
                                    "convention": "camelCase"
                                }
                            },
                            "strict": true,
                            "children": {
                                "I{{name}}Repository.ts": {
                                    "kind": "file",
                                    "required": true,
                                    "variables": {
                                        "name": {
                                            "convention": "PascalCase"
                                        }
                                    }
                                },
                                "{{implementation}}{{name}}Repository.ts": {
                                    "kind": "file",
                                    "required": true,
                                    "description": "Repository implementation file with unit test",
                                    "variables": {
                                        "name": {
                                            "convention": "PascalCase",
                                            "regex": "^[A-Z][a-zA-Z0-9]*$"
                                        },
                                        "implementation": {
                                            "convention": "PascalCase"
                                        }
                                    },
                                    "companions": [
                                        "{{implementation}}{{name}}Repository.unit.spec.ts"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}