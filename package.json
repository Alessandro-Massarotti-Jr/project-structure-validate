{
  "name": "project-structure-validate",
  "version": "1.0.0",
  "description": "Describe a project's folder and file structure in a .project-structure.json file and validate that the project follows it",
  "main": "build/index.js",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "tsc --noEmit && jest",
    "project-structure-validate": "npm run build && node build/cli.js",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "project-structure",
    "folder-structure",
    "file-structure",
    "lint",
    "validate",
    "cli"
  ],
  "author": "Alessandro Massarotti Jr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alessandro-Massarotti-Jr/project-structure-validate.git"
  },
  "homepage": "https://github.com/Alessandro-Massarotti-Jr/project-structure-validate#readme",
  "bugs": {
    "url": "https://github.com/Alessandro-Massarotti-Jr/project-structure-validate/issues"
  },
  "type": "commonjs",
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/node": "^24.19.2",
    "jest": "^30.5.2",
    "typescript": "^7.0.2"
  },
  "types": "build/index.d.ts",
  "bin": {
    "project-structure-validate": "build/cli.js"
  },
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=20.12"
  }
}
